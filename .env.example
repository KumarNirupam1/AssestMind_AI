# ---------------------------------------------------------------------------
# AssetMind AI — environment template
#
#   cp .env.example .env        # server-side: Prisma CLI, scripts
#   cp .env.example .env.local  # Next.js app
#
# `.env*` is gitignored; `.env.example` is committed and is the source of
# truth for which variables exist. Never put a real value in this file.
# ---------------------------------------------------------------------------


# --- Database (required) --------------------------------------------------
# Read by prisma7.config.ts and lib/db.ts.
#
# Keep this pointing at a *pooler*. A serverless deployment talking straight
# to RDS/Aurora exhausts max_connections; the teammate wiring RDS should point
# this at RDS Proxy or PgBouncer, not at the writer endpoint.
#
# Provider-specific query params (e.g. Neon's pgbouncer=true) belong in the
# real .env / Secrets Manager, not in this template. On Neon, run
# `prisma migrate deploy` against the *direct* (non-pooler) host.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Optional. Max connections in the explicit pg.Pool built by lib/db.ts.
# Defaults to 5 when unset.
# DATABASE_POOL_MAX=5


# --- Clerk (required) -----------------------------------------------------
# `npx clerk init` writes these into .env.local.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"


# --- Phase 2+ : not yet read by any code ----------------------------------
# Listed so onboarding is one file rather than three. Safe to leave blank
# until the phase that consumes them lands.


# OpenAI — chat completions + embeddings.
# Embedding model must stay 1536-dim to match DocumentChunk.embedding
# (vector(1536)). Bump both together; see architecture §3A.
# OPENAI_API_KEY=""

# Inngest — document ingestion background jobs.
# INNGEST_EVENT_KEY=""
# INNGEST_SIGNING_KEY=""

# AWS S3 — raw source documents. Teammate-owned.
# AWS_REGION=""
# S3_DOCUMENT_BUCKET=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
