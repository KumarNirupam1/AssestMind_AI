# ---------------------------------------------------------------------------
# AssetMind AI — environment template
#
#   cp .env.example .env        # server-side: Prisma CLI, scripts
#   cp .env.example .env.local  # Next.js app
#
# `.env*` is gitignored; `.env.example` is committed and is the source of
# truth for which variables exist. Never put a real value in this file.
# ---------------------------------------------------------------------------


# --- Database (required) --------------------------------------------------
# Read by prisma7.config.ts and lib/db.ts.
#
# Production: use the RDS endpoint below (direct — no pooler yet).
# RDS host: assetmind-db.cdiasc4eahtl.ap-south-1.rds.amazonaws.com:5432
# DB name:  assetmind
# User:     assetmind_admin
# The real credential is stored in AWS Secrets Manager:
#   assetmind/prod/database-url  (ap-south-1)
#
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Optional. Max connections in the explicit pg.Pool built by lib/db.ts.
# Defaults to 5 when unset. Keep low for serverless (RDS Proxy not yet set up).
# DATABASE_POOL_MAX=5


# --- Clerk (required) -----------------------------------------------------
# `npx clerk init` writes these into .env.local.
# Real Clerk secret key → Secrets Manager: assetmind/prod/clerk-secret-key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"


# --- OpenAI (required for agent + embeddings) -----------------------------
# Real key → Secrets Manager: assetmind/prod/openai-api-key
# Embedding model must stay text-embedding-3-small (1536-dim).
# OPENAI_API_KEY=""

# Embedding provider: "deterministic" (default, offline CI) or "openai" (real).
# Set to "openai" to run embed:backfill or live evaluation.
# ASSETMIND_EMBED_PROVIDER=deterministic


# --- Inngest (background ingestion jobs) ----------------------------------
# Real keys → Secrets Manager: assetmind/prod/inngest-keys
# INNGEST_EVENT_KEY=""
# INNGEST_SIGNING_KEY=""


# --- AWS (S3 document storage) --------------------------------------------
# Region and bucket are fixed for this project.
# In production (Vercel), credentials come from IAM role — do NOT set
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in Vercel env vars.
# For local dev, the assestmind AWS profile is used instead of env vars.
AWS_REGION="ap-south-1"
S3_DOCUMENT_BUCKET="assetmind-docs-919484652794"
# AWS_ACCESS_KEY_ID=""        # local dev only — use AWS_PROFILE=assestmind instead
# AWS_SECRET_ACCESS_KEY=""    # local dev only — use AWS_PROFILE=assestmind instead
